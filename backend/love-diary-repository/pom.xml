<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.chaohu</groupId>
        <artifactId>love-diary</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>love-diary-repository</artifactId>
    <name>love-diary-repository</name>
    <description>数据访问层：Mapper 接口与 MyBatis-Plus 配置</description>

    <dependencies>
        <dependency>
            <groupId>com.chaohu</groupId>
            <artifactId>love-diary-model</artifactId>
        </dependency>

        <!-- MyBatis-Plus。
             Boot 3 → mybatis-plus-spring-boot3-starter
             Boot 4 → mybatis-plus-spring-boot4-starter（两者不可混用）
             版本在根 pom 的 dependencyManagement 里锁定为 3.5.17。 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>

        <!-- MySQL 驱动，版本由 Spring Boot 父工程管理 -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

    </dependencies>
</project>
