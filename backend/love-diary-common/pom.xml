<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 父工程改成自己的根工程：继承链才真正建立起来 -->
    <parent>
        <groupId>com.chaohu</groupId>
        <artifactId>love-diary</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <!-- groupId / version / java.version 全部从父工程继承，不再重复写 -->
    <artifactId>love-diary-common</artifactId>
    <name>love-diary-common</name>
    <description>通用能力：统一响应、异常、常量、纯工具类</description>

    <dependencies>
        <!-- GlobalExceptionHandler 用到 @RestControllerAdvice / MethodArgumentNotValidException -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>

        <!-- JWTUtil 需要：api 编译期可见，impl / jackson 运行期加载 -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>
</project>
